{
  "name": "word-catcher",
  "description": "网页查词、原句翻译与 AI 语境详解",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "icons": "node scripts/build-icons.mjs",
    "preview": "wxt build && node scripts/preview.mjs",
    "preview:interactive": "node scripts/preview-interactive.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "release": "node scripts/release.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.14",
    "ai": "^7.0.37",
    "lucide-react": "^1.27.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@wxt-dev/module-react": "^1.1.5",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wxt": "^0.20.27"
  }
}
